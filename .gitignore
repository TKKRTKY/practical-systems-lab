# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
/build
next-env.d.ts

# testing
/coverage

# misc
.DS_Store
*.pem
.vercel
*.tsbuildinfo

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files
# Never commit real environment values. Keep only .env.example, with placeholders.
.env
.env.*
!.env.example

# local progress exports and scratch notes
# Exported progress files can contain personal study notes; keep them out of git.
/progress-export*.json
*.local.json
/notes/
/scratch/
/local/

# credentials and keys (defensive: this repository must never contain secrets)
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
*.kubeconfig
kubeconfig*
.npmrc
.netrc
credentials
credentials.json
service-account*.json

# editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
Thumbs.db
